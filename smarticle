<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smarticle| A multidisciplinary professional </title>

  <style>
    /* ===== COLOR PALETTE ===== */
    :root {
      --midnight: #0D0A14;
      --deep-navy: #11152B;
      --navy: #171B3A;
      --violet: #7656E8;
      --electric: #9A6CFF;
      --pink: #F06BD8;
      --soft-pink: #FCEAF8;
      --lavender: #EDE7FF;
      --white: #FFFFFF;
    }

    /* ===== GENERAL STYLES ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--white);
      color: var(--midnight);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button, input, select {
      font: inherit;
    }

    .container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* ===== NAVIGATION ===== */
    header {
      background: var(--midnight);
      color: var(--white);
      padding: 20px 0;
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--electric);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links a {
      font-size: 14px;
      color: #E4E0F0;
      transition: color 0.3s;
    }

    .nav-links a:hover {
      color: var(--pink);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .login {
      font-size: 14px;
      font-weight: bold;
    }

    .btn {
      display: inline-block;
      border: none;
      border-radius: 50px;
      padding: 13px 23px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s ease;
      text-align: center;
    }

    .btn-primary {
      background: var(--violet);
      color: var(--white);
    }

    .btn-primary:hover {
      background: var(--electric);
      transform: translateY(-2px);
    }

    .btn-light {
      background: var(--white);
      color: var(--navy);
    }

    .btn-light:hover {
      background: var(--lavender);
    }

    /* ===== HERO SECTION ===== */
    .hero {
      background:
        radial-gradient(
          circle at 85% 25%,
          rgba(118, 86, 232, 0.22),
          transparent 30%
        ),
        linear-gradient(
          120deg,
          var(--midnight),
          var(--deep-navy) 65%,
          var(--navy)
        );
      color: var(--white);
      padding: 85px 0 75px;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 55px;
    }

    .eyebrow {
      display: inline-block;
      color: #D9CFFF;
      background: rgba(154, 108, 255, 0.15);
      border: 1px solid rgba(154, 108, 255, 0.35);
      padding: 7px 15px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(42px, 5.3vw, 68px);
      line-height: 1.08;
      letter-spacing: -2.5px;
      margin-bottom: 24px;
    }

    .hero h1 span {
      background: linear-gradient(
        90deg,
        var(--electric),
        var(--pink)
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-text {
      color: #D4D0E3;
      max-width: 490px;
      font-size: 17px;
      margin-bottom: 30px;
    }

    /* ===== SEARCH BOX ===== */
    .search-box {
      background: var(--white);
      color: var(--midnight);
      padding: 10px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 560px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
    }

    .search-box select {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      padding: 12px 8px;
      background: transparent;
      color: var(--navy);
    }

    .search-box .btn {
      white-space: nowrap;
      padding: 14px 20px;
    }

    .hero-note {
      color: #B9B2D1;
      font-size: 12px;
      margin-top: 15px;
    }

    /* ===== HERO VISUAL ===== */
    .hero-visual {
      position: relative;
      min-height: 380px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .visual-glow {
      position: absolute;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: linear-gradient(
        135deg,
        var(--violet),
        var(--pink)
      );
      filter: blur(65px);
      opacity: 0.35;
    }

    .tutor-card {
      position: relative;
      z-index: 1;
      width: 290px;
      padding: 28px;
      border-radius: 25px;
      background: rgba(255, 255, 255, 0.09);
      border: 1px solid rgba(255, 255, 255, 0.17);
      backdrop-filter: blur(12px);
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.3);
      transform: rotate(-3deg);
    }

    .tutor-avatar {
      height: 170px;
      border-radius: 18px;
      background: linear-gradient(
        135deg,
        var(--lavender),
        var(--soft-pink)
      );
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 75px;
      margin-bottom: 20px;
    }

    .tutor-card h3 {
      font-size: 21px;
      margin-bottom: 4px;
    }

    .tutor-card p {
      color: #D7D1E8;
      font-size: 13px;
    }

    .tutor-rating {
      margin-top: 15px;
      color: #FFD47A;
      font-size: 14px;
    }

    .floating-tag {
      position: absolute;
      z-index: 2;
      background: var(--white);
      color: var(--navy);
      border-radius: 14px;
      padding: 13px 17px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      font-size: 13px;
      font-weight: bold;
    }

    .tag-one {
      top: 35px;
      right: 0;
    }

    .tag-two {
      bottom: 35px;
      left: 0;
      background: var(--soft-pink);
    }

    /* ===== TRUST BAR ===== */
    .trust-bar {
      padding: 28px 0;
      background: var(--white);
      border-bottom: 1px solid #EEEAF5;
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      text-align: center;
      gap: 20px;
    }

    .trust-item h3 {
      font-size: 25px;
      color: var(--violet);
    }

    .trust-item p {
      color: #777184;
      font-size: 13px;
    }

    /* ===== SUBJECTS ===== */
    .subjects {
      padding: 85px 0;
      background: #FAF9FF;
    }

    .section-heading {
      text-align: center;
      max-width: 650px;
      margin: 0 auto 45px;
    }

    .section-label {
      color: var(--violet);
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 2px;
      font-weight: bold;
    }

    .section-heading h2 {
      color: var(--navy);
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.2;
      margin: 12px 0;
      letter-spacing: -1px;
    }

    .section-heading p {
      color: #777184;
      font-size: 15px;
    }

    .subject-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .subject-card {
      background: var(--white);
      padding: 28px;
      border: 1px solid #EAE5F6;
      border-radius: 20px;
      transition: 0.3s ease;
    }

    .subject-card:hover {
      transform: translateY(-7px);
      border-color: var(--electric);
      box-shadow: 0 15px 35px rgba(23, 27, 58, 0.08);
    }

    .subject-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      border-radius: 15px;
      background: var(--lavender);
      font-size: 26px;
      margin-bottom: 20px;
    }

    .subject-card:nth-child(2) .subject-icon {
      background: var(--soft-pink);
    }

    .subject-card:nth-child(3) .subject-icon {
      background: #E5F6F0;
    }

    .subject-card h3 {
      color: var(--navy);
      font-size: 19px;
      margin-bottom: 8px;
    }

    .subject-card p {
      color: #777184;
      font-size: 14px;
      margin-bottom: 18px;
    }

    .text-link {
      color: var(--violet);
      font-weight: bold;
      font-size: 14px;
    }

    .text-link:hover {
      color: var(--pink);
    }

    /* ===== HOW IT WORKS ===== */
    .how-it-works {
      padding: 85px 0;
      background: var(--white);
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 35px;
    }

    .step {
      text-align: center;
      padding: 15px;
    }

    .step-number {
      width: 60px;
      height: 60px;
      margin: 0 auto 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 20px;
      background: var(--lavender);
      color: var(--violet);
      font-size: 22px;
      font-weight: bold;
    }

    .step:nth-child(2) .step-number {
      background: var(--soft-pink);
      color: #C13BA5;
    }

    .step h3 {
      color: var(--navy);
      margin-bottom: 10px;
    }

    .step p {
      color: #777184;
      font-size: 14px;
    }

    /* ===== CTA SECTION ===== */
    .cta-section {
      padding: 30px 0 85px;
    }

    .cta-box {
      background: linear-gradient(
        120deg,
        var(--deep-navy),
        var(--navy)
      );
      color: var(--white);
      border-radius: 28px;
      padding: 55px 30px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .cta-box h2 {
      font-size: clamp(29px, 4vw, 42px);
      margin-bottom: 15px;
    }

    .cta-box p {
      color: #D7D1E8;
      max-width: 540px;
      margin: 0 auto 25px;
    }

    /* ===== FOOTER ===== */
    footer {
      background: var(--midnight);
      color: var(--white);
      padding: 40px 0;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-content p {
      color: #B9B2D1;
      font-size: 13px;
    }

    .footer-links {
      display: flex;
      gap: 20px;
      font-size: 13px;
      color: #D7D1E8;
    }

    /* ===== RESPONSIVE DESIGN ===== */
    @media (max-width: 900px) {
      .nav-links {
        display: none;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .hero-copy {
        text-align: center;
      }

      .hero-text {
        margin-left: auto;
        margin-right: auto;
      }

      .search-box {
        margin: 0 auto;
      }

      .hero-note {
        text-align: center;
      }

      .hero-visual {
        min-height: 350px;
      }

      .subject-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .container {
        width: 92%;
      }

      header {
        padding: 16px 0;
      }

      .logo {
        font-size: 24px;
      }

      .nav-actions {
        gap: 12px;
      }

      .login {
        font-size: 12px;
      }

      .nav-actions .btn {
        padding: 10px 14px;
        font-size: 12px;
      }

      .hero {
        padding: 60px 0 45px;
      }

      .hero h1 {
        letter-spacing: -1.5px;
      }

      .search-box {
        flex-direction: column;
        align-items: stretch;
        padding: 12px;
      }

      .search-box select {
        width: 100%;
        padding: 12px;
        border-bottom: 1px solid #EEEAF5;
      }

      .hero-visual {
        min-height: 330px;
      }

      .tutor-card {
        width: 250px;
        padding: 20px;
      }

      .tutor-avatar {
        height: 140px;
      }

      .tag-one {
        right: -3px;
      }

      .tag-two {
        left: -3px;
      }

      .trust-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .subjects,
      .how-it-works {
        padding: 60px 0;
      }

      .subject-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .subject-card {
        padding: 24px;
      }

      .cta-box {
        padding: 40px 22px;
      }

      .footer-content {
        flex-direction: column;
        text-align: center;
      }

      .footer-links {
        justify-content: center;
        flex-wrap: wrap;
      }
    }
  </style>
</head>

