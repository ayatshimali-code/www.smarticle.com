<title>Circular Image Design</title>

<style>
/* Image container */
.profile-container {
    position: relative;
    width: 450px;
    height: 450px;
    margin: 60px auto;
}

/* Main circular image frame */
.image-frame {
    position: absolute;
    width: 380px;
    height: 380px;
    top: 35px;
    left: 35px;
    border-radius: 50%;
    padding: 7px;
    background: linear-gradient(
        135deg,
        #7656E8,
        #F06BD8,
        #9A6CFF
    );
    box-shadow: 0 0 25px rgba(154, 108, 255, 0.35);
    z-index: 2;
}

/* Image itself */
.image-frame img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 4px solid #11152B;
    box-sizing: border-box;
}

/* Decorative circle */
.circle-decoration {
    position: absolute;
    width: 420px;
    height: 420px;
    top: 15px;
    left: 15px;
    border: 2px solid #7656E8;
    border-radius: 50%;
    transform: rotate(-20deg);
}

/* Second decorative circle */
.circle-decoration::before {
    content: "";
    position: absolute;
    width: 440px;
    height: 440px;
    top: -12px;
    left: -12px;
    border: 2px dashed #F06BD8;
    border-radius: 50%;
    transform: rotate(35deg);
}



/* Second decorative line */
.decor-line-two {
    position: absolute;
    width: 65px;
    height: 4px;
    background: #9A6CFF;
    bottom: 45px;
    left: -5px;
    border-radius: 10px;
    transform: rotate(-35deg);
    z-index: 3;
}

/* Decorative dots */
.decor-dot {
    position: absolute;
    width: 14px;
    height: 14px;
    background: #F06BD8;
    border-radius: 50%;
    top: 35px;
    left: 40px;
    z-index: 3;
}

.decor-dot-two {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #9A6CFF;
    border-radius: 50%;
    bottom: 35px;
    right: 35px;
    z-index: 3;
}
</style>
</head>

